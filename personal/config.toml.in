onboarding = false

[ui]
copy_on_select = false

[theme]
name = "vesper"
auto_switch = false

[keys]
prefix = "ctrl+f"
copy_mode = "prefix+y"
copy_search = "prefix+f"
close_tab = "prefix+ctrl+w"
new_tab = "prefix+ctrl+t"
new_workspace = "prefix+ctrl+n"
close_workspace = "prefix+ctrl+q"
previous_tab = ["prefix+p", "prefix+left"]
next_tab = ["prefix+n", "prefix+right"]
previous_workspace = "prefix+up"
next_workspace = "prefix+down"
goto = "prefix+ctrl+f"
focus_agent = "prefix+alt+1..9"
switch_workspace = "prefix+shift+1..9"
workspace_picker = ""
switch_tab = "prefix+1..9"

[[keys.command]]
key = "prefix+t"
type = "popup"
command = "@PICKER@"
description = "Select tab: arrow keys or number"
width = 60
height = 16

[[keys.command]]
key = "prefix+w"
type = "popup"
command = "@PICKER@ workspace"
description = "Select workspace: arrow keys or number"
width = 60
height = 16

[[keys.command]]
key = "prefix+a"
type = "popup"
command = "@PICKER@ agent"
description = "Select agent: arrow keys or number"
width = 72
height = 16

# herdr-schedules-manager
[[keys.command]]
key = "prefix+c"
type = "popup"
command = "@SCHEDULES@ ui"
description = "Schedules: timing, prompts and results"
width = "90%"
height = "90%"
